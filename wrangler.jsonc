{
  // Cloudflare Workers 配置 — infinite-canvas
  // 静态资源（Vite 产物）与 API/代理（worker/）由同一个 Worker 提供服务，因此前后端同源，
  // 会话直接用 httpOnly Cookie，不需要任何 CORS 配置。
  //
  // name 必须与 Cloudflare 面板中的 Worker 项目名称完全一致，否则部署会失败。
  "name": "infinite-canvas",

  // 决定运行时行为与默认路由策略，不要为了"更新"而随意改。
  // 2026-09-16 >= 2025-04-01，因此默认启用 assets_navigation_prefers_asset_serving：
  // 导航请求直接由静态资源响应（深层路由不 404、不消耗 Worker 调用），
  // 只有页面内的 fetch() 未命中静态资源时才调用 Worker。
  "compatibility_date": "2026-09-16",

  // API、代理与登录门禁的入口
  "main": "./worker/index.ts",

  "assets": {
    // 由 `cd web && bun run build` 生成的 Vite 产物目录（相对本文件所在的仓库根）。
    "directory": "./web/dist",

    // SPA 路由兜底：未命中静态文件的请求一律返回 /index.html（200），而不是 404。
    "not_found_handling": "single-page-application",

    // 让 Worker 能通过 env.ASSETS.fetch() 兜底取静态资源。
    "binding": "ASSETS"
  },

  // ---------------------------------------------------------------------------
  // 自定义域名。
  //
  // `*.workers.dev` 在部分网络下会被 **SNI 级阻断**：TCP 443 可达，但 TLS 握手被打断。
  // 实测换 DNS、换 hosts、换 CF 边缘 IP 全都无效，而同 IP 段的自有域名完全正常。
  // 所以"用户真的能打开"这件事依赖这个域名，不能只靠 workers.dev。
  //
  // custom_domain: true 时 wrangler 会自动建 DNS 记录并签发证书（该 zone 必须在本账户下）。
  // 首次启用需要 `Workers Custom Domains: Edit` 权限。
  // ---------------------------------------------------------------------------
  "routes": [
    {
      "pattern": "canvas.joinhu01.fun",
      "custom_domain": true
    }
  ],

  // ---------------------------------------------------------------------------
  // 用户、共享配置与渠道密钥（门禁已启用）。
  //
  // 这一步是三道坎里最容易踩的：database_id 无效时 wrangler deploy 会在解析绑定阶段
  // 直接失败（Couldn't find a D1 DB with the id ...），把线上构建打红——所以**必须**
  // 先 d1 create 拿到真实 id 再启用本段。反过来，绑定缺失时 Worker 照常部署、静态站点
  // 不受影响，只有 /api/* 返回 server_not_configured(500)，前端进 degraded 照常可用。
  //
  // 建库与设密钥已完成（2026-09-16）：
  //    1) ✔ d1 create infinite-canvas → id 见下
  //    2) ✔ d1 execute --remote --file=./worker/schema.sql（users / app_config / channel_secrets）
  //    3) ✔ secret put AUTH_SECRET
  //
  // 换账号或重建库时，上面三步要重来一遍。
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infinite-canvas",
      "database_id": "989c4426-c843-4eea-b8e4-122523b100fe"
    }
  ]
}
